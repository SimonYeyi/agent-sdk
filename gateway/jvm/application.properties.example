# ---------- Required ----------
# LLM provider credentials. provider optional value: anthropic or openai
model.api.key=
model.base.url=
model.name=

# Feishu open platform app credentials.
feishu.app.id=
feishu.app.secret=

# ---------- Optional ----------
# 'anthropic' or 'openai'. Empty -> infer from model.base.url
# (contains 'anthropic' -> anthropic, otherwise openai).
model.provider=

# App data root. Both :gateway:core and :session.SessionRepository
# create their own subdirs under it (gateway/sessions/ and agent/sessions/
# respectively). Empty -> default is ${user.home}/.gateway-jvm.
gateway.app.storage.dir=

# Cap on concurrent agent sessions (per-engine).
# Default: 10.
gateway.max.concurrent.sessions=

# ---------- Override behavior ----------
# Any of the above keys may be overridden by a system environment variable
# whose name is the uppercased, dot-replaced form, e.g.
#   model.api.key    <->  MODEL_API_KEY
#   feishu.app.id    <->  FEISHU_APP_ID
# If GATEWAY_CONFIG is set, its path is used; otherwise ./application.properties.
# Missing required keys cause the daemon to fail fast at startup.
